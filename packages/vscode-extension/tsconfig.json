{
    "compilerOptions": {
        "target": "esnext",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["esnext"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "declaration": false,
        "typeRoots": ["./node_modules/@types"]
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["./node_modules"]
}
