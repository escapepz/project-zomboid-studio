{
    "name": "pzstudio",
    "displayName": "Project Zomboid Studio",
    "publisher": "escapepz",
    "version": "2.242170.0",
    "description": "Effortlessly create and maintain Lua mods for Project Zomboid with intuitive structuring.",
    "main": "./dist/extension.js",
    "type": "commonjs",
    "engines": {
        "vscode": "^1.102.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "icon.png",
    "activationEvents": [],
    "contributes": {
        "configuration": {
            "title": "Project Zomboid Studio",
            "properties": {
                "pzstudio.templates.project.url": {
                    "type": "string",
                    "description": "Repository URL for the default project template (e.g. https://github.com/org/repo.git)",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-project.git"
                },
                "pzstudio.templates.project.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the project template",
                    "scope": "resource",
                    "default": "42.17.0"
                },
                "pzstudio.templates.mod.url": {
                    "type": "string",
                    "description": "Repository URL for the default mod template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-mod.git"
                },
                "pzstudio.templates.mod.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the mod template",
                    "scope": "resource",
                    "default": "42.17.0"
                },
                "pzstudio.templates.workshop.url": {
                    "type": "string",
                    "description": "Repository URL for the default workshop template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-workshop.git"
                },
                "pzstudio.templates.workshop.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the workshop template",
                    "scope": "resource",
                    "default": "42.0"
                },
                "pzstudio.templates.language.url": {
                    "type": "string",
                    "description": "Repository URL for the default language template",
                    "scope": "resource",
                    "default": "https://github.com/escapepz/pzstudio-template-language.git"
                },
                "pzstudio.templates.language.ref": {
                    "type": "string",
                    "description": "Git ref (branch, tag, or commit) for the language template",
                    "scope": "resource",
                    "default": "42.13.1"
                },
                "pzstudio.outdir": {
                    "type": "string",
                    "description": "Default build output directory",
                    "scope": "resource",
                    "default": ""
                },
                "pzstudio.useSymlinks": {
                    "type": "boolean",
                    "description": "Whether to use symlinks instead of copying during build",
                    "scope": "resource",
                    "default": true
                },
                "pzstudio.verbose": {
                    "type": "boolean",
                    "description": "Enable verbose/diagnostic output for all commands (--verbose)",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.offline": {
                    "type": "boolean",
                    "description": "Skip remote template refresh and use cached/legacy data (--offline). Applies to New Project and Add Mod.",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.forceUpdate": {
                    "type": "boolean",
                    "description": "Force refresh of cached templates (--force-update). Applies to New Project and Add Mod.",
                    "scope": "resource",
                    "default": false
                },
                "pzstudio.build.target": {
                    "type": "string",
                    "enum": [
                        "default",
                        "production",
                        "development"
                    ],
                    "enumDescriptions": [
                        "Build the main workshop output (same as production)",
                        "Build the main workshop output (--production)",
                        "Build the dev_branch workshop output (--development)"
                    ],
                    "description": "Build target mode. Controls whether to build the main or dev_branch workshop output.",
                    "scope": "resource",
                    "default": "default"
                }
            }
        },
        "commands": [
            {
                "command": "pzstudio.new",
                "title": "PZStudio: New Project"
            },
            {
                "command": "pzstudio.add",
                "title": "PZStudio: Add Mod"
            },
            {
                "command": "pzstudio.build",
                "title": "PZStudio: Build"
            },
            {
                "command": "pzstudio.clean",
                "title": "PZStudio: Clean"
            },
            {
                "command": "pzstudio.delete",
                "title": "PZStudio: Delete Mod"
            },
            {
                "command": "pzstudio.lang",
                "title": "PZStudio: New Language"
            },
            {
                "command": "pzstudio.rename",
                "title": "PZStudio: Rename Mod"
            },
            {
                "command": "pzstudio.update",
                "title": "PZStudio: Update"
            },
            {
                "command": "pzstudio.watch",
                "title": "PZStudio: Watch"
            },
            {
                "command": "pzstudio.modinfoGenerate",
                "title": "PZStudio: ModInfo Generate"
            }
        ]
    },
    "homepage": "https://marketplace.visualstudio.com/items?itemName=escapepz.pzstudio",
    "repository": {
        "type": "git",
        "url": "https://github.com/escapepz/project-zomboid-studio.git",
        "directory": "packages/vscode-extension"
    },
    "bugs": {
        "url": "https://github.com/escapepz/project-zomboid-studio/issues"
    },
    "author": "escapepz",
    "contributors": [
        {
            "name": "escapepz",
            "url": "https://github.com/escapepz"
        },
        {
            "name": "asledgehammer",
            "url": "https://github.com/asledgehammer"
        },
        {
            "name": "demiurgeQuantified",
            "url": "https://github.com/demiurgeQuantified"
        }
    ],
    "funding": [
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/escapepz"
        },
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/konijima"
        }
    ],
    "license": "Apache-2.0",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\"",
        "bundle": "node scripts/bundle.js",
        "build": "pnpm run clean && pnpm run bundle",
        "vsce:package": "vsce package --no-dependencies",
        "watch": "pnpm run clean && node scripts/bundle.js --watch"
    },
    "devDependencies": {
        "@types/vscode": "^1.102.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "pzstudio-cli": "workspace:*"
    }
}
