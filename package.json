{
    "name": "pzstudio",
    "displayName": "Project Zomboid Studio",
    "publisher": "escapepz",
    "version": "2.2.0-b42.13.1-vscode-ext-alpha",
    "branch": "b42.13.1",
    "description": "",
    "main": "./dist/extension.js",
    "type": "commonjs",
    "engines": {
        "vscode": "^1.102.0"
    },
    "categories": [
        "Other"
    ],
    "icon": ".template-project/workshop/preview.png",
    "activationEvents": [],
    "contributes": {
        "commands": [
            {
                "command": "pzstudio.new",
                "title": "PZStudio: New Project"
            },
            {
                "command": "pzstudio.add",
                "title": "PZStudio: Add Mod"
            },
            {
                "command": "pzstudio.build",
                "title": "PZStudio: Build"
            },
            {
                "command": "pzstudio.clean",
                "title": "PZStudio: Clean"
            },
            {
                "command": "pzstudio.delete",
                "title": "PZStudio: Delete Mod"
            },
            {
                "command": "pzstudio.lang",
                "title": "PZStudio: New Language"
            },
            {
                "command": "pzstudio.rename",
                "title": "PZStudio: Rename Mod"
            },
            {
                "command": "pzstudio.update",
                "title": "PZStudio: Update"
            },
            {
                "command": "pzstudio.watch",
                "title": "PZStudio: Watch"
            }
        ]
    },
    "bin": {
        "pzstudio": "./dist/index.js"
    },
    "publishConfig": {
        "tag": "alpha"
    },
    "homepage": "https://marketplace.visualstudio.com/items?itemName=escapepz.pzstudio",
    "repository": {
        "type": "git",
        "url": "https://github.com/escapepz/project-zomboid-studio.git"
    },
