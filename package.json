        },
        {
            "name": "asledgehammer",
            "url": "https://github.com/asledgehammer"
        },
        {
            "name": "demiurgeQuantified",
            "url": "https://github.com/demiurgeQuantified"
        }
    ],
    "funding": [
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/escapepz"
        },
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/konijima"
        }
    ],
    "license": "Apache-2.0",
    "scripts": {
        "clean": "del-cli --force ./dist",
        "bundle": "node scripts/bundle.js",
        "build": "npm run clean && npm run bundle && node scripts/update-build-date.js",
        "vsce:package": "vsce package --no-dependencies",
        "watch": "npm run clean && node scripts/bundle.js --watch",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "pzstudio",
        "modding-tool",
        "project-zomboid",
        "project-zomboid-studio"
    ],
    "devDependencies": {
        "@types/node": "^18.7.5",
        "@types/terminal-kit": "^2.5.1",
        "@types/vscode": "^1.102.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.2",
        "prettier": "^3.7.4",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "chokidar": "^3.5.3",
        "del-cli": "^4.0.1",
        "download": "^8.0.0",
        "terminal-kit": "^3.0.0",
        "tslib": "^2.8.1"
    }
